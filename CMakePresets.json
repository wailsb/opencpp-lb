{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "LB_BUILD_TESTS": "ON" }
    },
    {
      "name": "dev",
      "displayName": "Debug (warnings on)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "ci",
      "displayName": "CI (Debug, warnings as errors)",
      "inherits": "dev",
      "cacheVariables": { "LB_WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "release",
      "displayName": "Release with debug info",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer + UBSan (GCC/Clang)",
      "inherits": "dev",
      "cacheVariables": { "LB_SANITIZE": "address,undefined" }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer (GCC/Clang)",
      "inherits": "dev",
      "cacheVariables": { "LB_SANITIZE": "thread" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "ci", "configurePreset": "ci" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" }
  ],
  "testPresets": [
    { "name": "base", "hidden": true, "output": { "outputOnFailure": true }, "execution": { "timeout": 120 } },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    { "name": "ci", "inherits": "base", "configurePreset": "ci" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "asan", "inherits": "base", "configurePreset": "asan" },
    { "name": "tsan", "inherits": "base", "configurePreset": "tsan" }
  ]
}
